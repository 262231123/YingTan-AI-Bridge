<UserControl x:Class="RevitCodexBridge.Addin.ChatDockPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360"
             MinHeight="420"
             Background="#F5F6F8"
             FontFamily="Microsoft YaHei UI"
             FontSize="12">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#20242B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#68707D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DDE4" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F0F4FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="154" MinWidth="132" />
            <ColumnDefinition Width="*" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#ECEEF2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="对话" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <Button Grid.Column="1" Content="新建" Style="{StaticResource CommandButton}" Height="28" Padding="9,0" Click="NewConversationOnClick" />
                </Grid>

                <ListBox x:Name="ConversationList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ConversationListOnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#E2E6ED" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding UpdatedText}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="删除当前对话" Style="{StaticResource CommandButton}" VerticalAlignment="Bottom" Click="DeleteConversationOnClick" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ConversationTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProviderStatus" Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="配置" Style="{StaticResource CommandButton}" Height="30" Click="SettingsOnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                    <ItemsControl x:Name="MessageItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Bubble"
                                        MaxWidth="520"
                                        Margin="0,0,38,12"
                                        Padding="12,9"
                                        HorizontalAlignment="Left"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding TimeText}" DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        </DockPanel>
                                        <TextBox x:Name="MessageText"
                                                 Text="{Binding Content, Mode=OneWay}"
                                                 Margin="0,6,0,0"
                                                 Padding="0"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextBrush}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="False"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 TextBlock.LineHeight="20" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Margin" Value="38,0,0,12" />
                                        <Setter TargetName="Bubble" Property="Background" Value="#EAF2FF" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#C7D9F8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter TargetName="Bubble" Property="Background" Value="#FFF1F1" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#F1B8B8" />
                                        <Setter TargetName="MessageText" Property="Foreground" Value="#9B1C1C" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyState"
                           Text="开始一段关于当前 Revit 模型的对话"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13" />
            </Grid>

            <Border x:Name="PendingPlanBar" Grid.Row="2" Margin="14,0,14,8" Padding="10,8" Background="#FFF8E8" BorderBrush="#E8D39B" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="ExecutePlanButton" DockPanel.Dock="Right" Content="执行计划" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="ExecutePlanOnClick" />
                    <TextBlock Text="计划已通过安全预演，等待写入模型" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#66501B" />
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Margin="14,0,14,10" Padding="9" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PromptBox"
                             MinHeight="58"
                             MaxHeight="150"
                             Padding="2"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource TextBrush}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="输入消息，Ctrl+Enter 发送"
                             PreviewKeyDown="PromptBoxOnPreviewKeyDown" />
                    <DockPanel Grid.Row="1" LastChildFill="False">
                        <TextBlock x:Name="ComposerHint" Text="AI 生成的写操作会先预演" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="发送" Width="76" Style="{StaticResource PrimaryButton}" Click="SendOnClick" />
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="#ECEEF2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <TextBlock x:Name="RuntimeStatus" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BusyProgress" Height="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

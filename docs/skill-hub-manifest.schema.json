{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YingTan Skill Hub Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "version", "publisher", "hosts", "triggers", "commandProfiles", "integrity", "signature"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.][A-Za-z0-9.]+)?$" },
    "publisher": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "minimumBridgeVersion"],
        "properties": {
          "id": { "enum": ["revit", "autocad", "rhino", "inventor"] },
          "hostVersions": { "type": "array", "items": { "type": "string" } },
          "minimumBridgeVersion": { "type": "string" },
          "requiredCapabilityExtensions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "triggers": {
      "type": "object",
      "properties": {
        "keywords": { "type": "array", "items": { "type": "string" } },
        "negativeKeywords": { "type": "array", "items": { "type": "string" } },
        "intentTags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commandProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "recommendedCommands", "risk"],
        "properties": {
          "host": { "type": "string" },
          "recommendedCommands": { "type": "array", "items": { "type": "string" } },
          "risk": { "enum": ["read", "write"] }
        }
      }
    },
    "requiresConfirmation": { "type": "boolean" },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
